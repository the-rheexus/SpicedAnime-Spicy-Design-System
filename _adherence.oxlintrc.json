{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/navigation/**",
              "ui_kits/fulfillment-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgingFlag'] > JSXAttribute > JSXIdentifier[name!=/^(?:sinceIso|now|thresholdDays|style|key|ref|className|style|children)$/]",
        "message": "<AgingFlag> doesn't accept that prop. Declared props: sinceIso, now, thresholdDays, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|sidebarProps|topBarProps|sidebar|topBar|children|contentMax|style|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: active, onNavigate, sidebarProps, topBarProps, sidebar, topBar, children, contentMax, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|solid|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, solid, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|spice|info|success|warning|danger)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'spice' | 'info' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatchCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:batchId|title|status|statusLabel|statusContext|aging|units|ordersCount|printed|blocked|due|primaryLabel|onGenerate|onOpen|singleAction|style|key|ref|className|style|children)$/]",
        "message": "<BatchCard> doesn't accept that prop. Declared props: batchId, title, status, statusLabel, statusContext, aging, units, ordersCount, printed, blocked, due, primaryLabel, onGenerate, onOpen, singleAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatchCard'] > JSXAttribute[name.name='statusContext'] > Literal[value!=/^(?:batches|component|reprint)$/]",
        "message": "<BatchCard> statusContext must be one of 'batches' | 'component' | 'reprint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|fullWidth|disabled|loading|onClick|type|href|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, fullWidth, disabled, loading, onClick, type, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|outline|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'outline' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|eyebrow|action|accent|padding|interactive|onClick|style|bodyStyle|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, title, eyebrow, action, accent, padding, interactive, onClick, style, bodyStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|indeterminate|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, indeterminate, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|tone|title|children|confirmLabel|cancelLabel|onConfirm|onCancel|loading|key|ref|className|style|children)$/]",
        "message": "<ConfirmModal> doesn't accept that prop. Declared props: open, tone, title, children, confirmLabel, cancelLabel, onConfirm, onCancel, loading."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmModal'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|danger|warning)$/]",
        "message": "<ConfirmModal> tone must be one of 'default' | 'danger' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|header|align|width|mono|sortable|render|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, header, align, width, mono, sortable, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeferredPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:tag|title|children|eta|style|key|ref|className|style|children)$/]",
        "message": "<DeferredPanel> doesn't accept that prop. Declared props: tag, title, children, eta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|action|compact|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, children, action, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorAlert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|action|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<ErrorAlert> doesn't accept that prop. Declared props: tone, title, children, action, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorAlert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:error|warning|info|success)$/]",
        "message": "<ErrorAlert> tone must be one of 'error' | 'warning' | 'info' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|count|key|ref|className|style|children)$/]",
        "message": "<FilterPill> doesn't accept that prop. Declared props: value, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|spin|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, spin, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|variant|active|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, variant, active, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|solid)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|placeholder|onChange|iconLeft|type|disabled|error|hint|mono|fullWidth|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, defaultValue, placeholder, onChange, iconLeft, type, disabled, error, hint, mono, fullWidth, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadingState'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|label|rows|logoSrc|style|key|ref|className|style|children)$/]",
        "message": "<LoadingState> doesn't accept that prop. Declared props: variant, label, rows, logoSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadingState'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:spinner|skeleton|inline)$/]",
        "message": "<LoadingState> variant must be one of 'spinner' | 'skeleton' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|delta|trend|icon|accent|hint|onClick|href|style|key|ref|className|style|children)$/]",
        "message": "<MetricCard> doesn't accept that prop. Declared props: label, value, unit, delta, trend, icon, accent, hint, onClick, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricCard'] > JSXAttribute[name.name='trend'] > Literal[value!=/^(?:up|down|flat)$/]",
        "message": "<MetricCard> trend must be one of 'up' | 'down' | 'flat'."
