        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='context'] > Literal[value!=/^(?:batches|component|reprint)$/]",
        "message": "<StatusBadge> context must be one of 'batches' | 'component' | 'reprint'."
